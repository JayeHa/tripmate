# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase
supabase/.temp
supabase/.branches

# 디자인 핸드오프 패키지 (로컬 참조용, 레포에 커밋하지 않음)
design_handoff_tripmate/

# 도시 사진 원본 (pnpm cities:images 가 변환해 public/city-images 로 옮긴다). 안내 파일만 커밋한다
city-images-inbox/*
!city-images-inbox/README.md

# pdf.js 가 따로 받는 파일 — dev · build 때 scripts/copy-pdfjs.mjs 가 복사한다
/public/pdfjs/
